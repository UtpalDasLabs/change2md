{
  "manifest_version": 3,
  "name": "Change2MD",
  "version": "0.2.0",
  "description": "Convert the current public webpage to Markdown for any AI chat or model.",
  "permissions": ["tabs"],
  "host_permissions": ["https://change2md.vercel.app/*"],
  "action": {
    "default_title": "Convert this page to Markdown",
    "default_popup": "popup.html"
  }
}
